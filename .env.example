# Turso (libSQL) connection.
# For local development you can use a local file, e.g.:
#   TURSO_DATABASE_URL=file:local.db
# For Turso cloud, use the libsql URL + auth token from `turso db show` / `turso db tokens create`:
#   TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
#   TURSO_AUTH_TOKEN=your-auth-token
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Secret used to sign session JWTs. Use a long random string (e.g. `openssl rand -hex 32`).
AUTH_SECRET=change-me-to-a-long-random-string
